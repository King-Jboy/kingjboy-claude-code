# NVIDIA NIM Config
NVIDIA_NIM_API_KEY=""
# Optional pool of interchangeable NVIDIA NIM keys as a JSON list, for example
# NVIDIA_NIM_API_KEYS='["key-one", "key-two"]'. Two or more keys replace the
# single key above: requests rotate across the pool, and a rejected or
# rate-limited key cools down and re-enters rotation on its own.
NVIDIA_NIM_API_KEYS=""
# Optional per-key usage budget; 0 (default) meters nothing because NIM's free
# tier is rate-limited per minute rather than by a call budget.
NVIDIA_NIM_KEY_USAGE_LIMIT=0


# Azure OpenAI (resource-specific OpenAI v1 Chat Completions endpoint)
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_BASE_URL=""


# OpenRouter Config
OPENROUTER_API_KEY=""
# Optional pool of interchangeable OpenRouter keys as a JSON list, for example
# OPENROUTER_API_KEYS='["key-one", "key-two"]'. Free-tier limits are enforced
# per account, so treat extra keys as redundancy rather than added throughput.
OPENROUTER_API_KEYS=""
# Usage budget counted per key per 24h window (free tier caps each key daily).
# A key that reaches it sits out until the window rolls over; 0 meters nothing.
OPENROUTER_KEY_USAGE_LIMIT=1000


